# Template configuration file for AI Agent for Seasonal Crop Planning
# Copy this file to .env and add your personal keys

# OpenWeatherMap API Key (Get free key from https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
